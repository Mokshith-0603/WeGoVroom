rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null && hasAllowedEmailDomain();
    }

    function hasAllowedEmailDomain() {
      let email = request.auth.token.get("email", "");
      return request.auth != null
        && email is string
        && (
          email.matches('^.+@vitapstudent[.]ac[.]in$')
          || email.matches('^.+@vitap[.]ac[.]in$')
        );
    }

    function uid() {
      return request.auth.uid;
    }

    function userPath(userId) {
      return /databases/$(database)/documents/users/$(userId);
    }

    function tripPath(tripId) {
      return /databases/$(database)/documents/trips/$(tripId);
    }

    function tripParticipantPath(tripId, userId) {
      return /databases/$(database)/documents/tripParticipants/$(tripId + "_" + userId);
    }

    function tripExists(tripId) {
      return exists(tripPath(tripId));
    }

    function tripData(tripId) {
      return get(tripPath(tripId)).data;
    }

    function tripOwnerId(tripId) {
      return tripData(tripId).ownerId;
    }

    function isTripOwner(tripId) {
      return signedIn() && tripExists(tripId) && tripOwnerId(tripId) == uid();
    }

    function isTripParticipant(tripId, userId) {
      return tripExists(tripId) && exists(tripParticipantPath(tripId, userId));
    }

    function isTripMember(tripId) {
      return signedIn()
        && tripExists(tripId)
        && (
          tripOwnerId(tripId) == uid()
          || isTripParticipant(tripId, uid())
        );
    }

    function canSelfJoinTrip(tripId) {
      return signedIn()
        && tripExists(tripId)
        && tripData(tripId).get("completed", false) != true
        && (
          tripData(tripId).get("isPublic", true) != false
          || tripOwnerId(tripId) == uid()
          || (
            tripData(tripId).get("invitedUserIds", []) is list
            && tripData(tripId).get("invitedUserIds", []).hasAny([uid()])
          )
          || (
            request.auth.token.get("email", "") is string
            && tripData(tripId).get("invitedUserEmails", []) is list
            && tripData(tripId).get("invitedUserEmails", []).hasAny([
              request.auth.token.get("email", "")
            ])
          )
        );
    }

    function canSelfAdjustTripCount(tripId) {
      let beforeJoined = (resource.data.joined is int || resource.data.joined is float)
        ? resource.data.joined
        : 1;
      let afterJoined = (request.resource.data.joined is int || request.resource.data.joined is float)
        ? request.resource.data.joined
        : beforeJoined;
      let maxPeople = (resource.data.maxPeople is int || resource.data.maxPeople is float)
        ? resource.data.maxPeople
        : 4;
      return signedIn()
        && request.resource.data.diff(resource.data).changedKeys().hasOnly(["joined"])
        && (
          (
            canSelfJoinTrip(tripId)
            && afterJoined == beforeJoined + 1
            && afterJoined <= maxPeople
          )
          || (
            exists(tripParticipantPath(tripId, uid()))
            && afterJoined == beforeJoined - 1
            && afterJoined >= 1
          )
        );
    }

    function isAdmin() {
      return signedIn() && (
        request.auth.token.admin == true
        || request.auth.token.admin == 1
        || (
          request.auth.token.admin is string
          && request.auth.token.admin.matches('(?i)^\\s*(true|1|yes)\\s*$')
        )
        || request.auth.token.isAdmin == true
        || request.auth.token.isAdmin == 1
        || (
          request.auth.token.isAdmin is string
          && request.auth.token.isAdmin.matches('(?i)^\\s*(true|1|yes)\\s*$')
        )
        || (
          request.auth.token.role is string
          && request.auth.token.role.matches('(?i)^\\s*admin\\s*$')
        )
        || (
          exists(userPath(uid()))
          && (
            (
              get(userPath(uid())).data.role is string
              && get(userPath(uid())).data.role.matches('(?i)^\\s*admin\\s*$')
            )
            || get(userPath(uid())).data.isAdmin == true
            || get(userPath(uid())).data.isAdmin == 1
            || (
              get(userPath(uid())).data.isAdmin is string
              && get(userPath(uid())).data.isAdmin.matches('(?i)^\\s*(true|1|yes)\\s*$')
            )
            || get(userPath(uid())).data.admin == true
            || get(userPath(uid())).data.admin == 1
            || (
              get(userPath(uid())).data.admin is string
              && get(userPath(uid())).data.admin.matches('(?i)^\\s*(true|1|yes)\\s*$')
            )
          )
        )
      );
    }

    function isTripNotificationType(t) {
      return t is string && (
        t == "trip_request"
        || t == "trip_request_approved"
        || t == "trip_request_rejected"
        || t == "trip_joined"
        || t == "trip_left"
        || t == "trip_removed"
      );
    }

    function canCreateTripNotification() {
      return signedIn()
        && request.resource.data.keys().hasOnly([
          "userId",
          "message",
          "type",
          "tripId",
          "actorId",
          "actorName",
          "isRead",
          "createdAt"
        ])
        && request.resource.data.userId is string
        && request.resource.data.message is string
        && request.resource.data.type is string
        && request.resource.data.tripId is string
        && request.resource.data.actorId is string
        && request.resource.data.actorName is string
        && request.resource.data.isRead == false
        && isTripNotificationType(request.resource.data.type)
        && request.resource.data.actorId == uid()
        && tripExists(request.resource.data.tripId)
        && (
          (
            (
              request.resource.data.type == "trip_request"
              || request.resource.data.type == "trip_joined"
              || request.resource.data.type == "trip_left"
            )
            && request.resource.data.userId == tripOwnerId(request.resource.data.tripId)
            && request.resource.data.userId != uid()
          )
          || (
            (
              request.resource.data.type == "trip_removed"
              || request.resource.data.type == "trip_request_approved"
              || request.resource.data.type == "trip_request_rejected"
            )
            && uid() == tripOwnerId(request.resource.data.tripId)
            && request.resource.data.userId != uid()
          )
        );
    }

    match /users/{userId} {
      allow read: if signedIn();
      allow create, update, delete: if signedIn() && uid() == userId;

      match /tripMergeRequests/{requestId} {
        allow read: if signedIn() && uid() == userId;
        allow create, update, delete: if false;
      }
    }

    match /trips/{tripId} {
      allow read: if signedIn();
      allow create: if signedIn()
        && request.resource.data.ownerId == uid();
      allow update: if isTripOwner(tripId)
        || isAdmin()
        || canSelfAdjustTripCount(tripId);
      allow delete: if isTripOwner(tripId) || isAdmin();
    }

    match /tripParticipants/{participant} {
      allow read: if signedIn();

      allow create: if signedIn()
        && request.resource.data.keys().hasOnly([
          "tripId",
          "userId",
          "name",
          "avatar",
          "isHost",
          "createdAt"
        ])
        && request.resource.data.tripId is string
        && request.resource.data.userId is string
        && request.resource.data.name is string
        && (
          request.resource.data.avatar is int
          || request.resource.data.avatar is float
        )
        && request.resource.data.isHost is bool
        && participant == request.resource.data.tripId + "_" + request.resource.data.userId
        && tripExists(request.resource.data.tripId)
        && (
          (
            request.resource.data.userId == uid()
            && canSelfJoinTrip(request.resource.data.tripId)
          )
          || isTripOwner(request.resource.data.tripId)
        );

      allow update: if false;

      allow delete: if signedIn() && (
        resource.data.userId == uid()
        || isTripOwner(resource.data.tripId)
        || isAdmin()
      );
    }

    match /tripRequests/{requestId} {
      allow read: if signedIn() && (
        resource.data.userId == uid()
        || isTripOwner(resource.data.tripId)
        || isAdmin()
      );

      allow create: if signedIn()
        && request.resource.data.keys().hasOnly([
          "tripId",
          "hostId",
          "ownerId",
          "userId",
          "name",
          "avatar",
          "email",
          "status",
          "createdAt"
        ])
        && request.resource.data.tripId is string
        && tripExists(request.resource.data.tripId)
        && request.resource.data.userId == uid()
        && uid() != tripOwnerId(request.resource.data.tripId)
        && request.resource.data.status == "pending"
        && (
          !request.resource.data.keys().hasAny(["hostId"])
          || (
            request.resource.data.hostId is string
            && request.resource.data.hostId == tripOwnerId(request.resource.data.tripId)
          )
        )
        && (
          !request.resource.data.keys().hasAny(["ownerId"])
          || (
            request.resource.data.ownerId is string
            && request.resource.data.ownerId == tripOwnerId(request.resource.data.tripId)
          )
        )
        && (
          !request.resource.data.keys().hasAny(["name"])
          || request.resource.data.name is string
        )
        && (
          !request.resource.data.keys().hasAny(["email"])
          || request.resource.data.email is string
        );

      allow update: if signedIn()
        && isTripOwner(resource.data.tripId)
        && resource.data.status == "pending"
        && request.resource.data.diff(resource.data).changedKeys().hasOnly([
          "status",
          "decidedAt",
          "decidedBy"
        ])
        && request.resource.data.status != "pending"
        && (
          request.resource.data.status == "approved"
          || request.resource.data.status == "rejected"
        )
        && request.resource.data.decidedBy == uid();

      allow delete: if false;
    }

    match /tripMergeRequests/{requestId} {
      allow read: if signedIn()
        && resource.data.hostIds is list
        && uid() in resource.data.hostIds;
      allow create, update, delete: if false;

      match /acceptances/{hostId} {
        allow read: if signedIn()
          && get(/databases/$(database)/documents/tripMergeRequests/$(requestId))
            .data.hostIds is list
          && uid() in get(/databases/$(database)/documents/tripMergeRequests/$(requestId))
            .data.hostIds;
        allow create: if signedIn()
          && hostId == uid()
          && get(/databases/$(database)/documents/tripMergeRequests/$(requestId))
            .data.status == "pending"
          && get(/databases/$(database)/documents/tripMergeRequests/$(requestId))
            .data.hostIds is list
          && uid() in get(/databases/$(database)/documents/tripMergeRequests/$(requestId))
            .data.hostIds
          && request.resource.data.keys().hasOnly(["accepted", "createdAt"])
          && request.resource.data.accepted is bool;
        allow update, delete: if false;
      }
    }

    match /tripMessages/{message} {
      allow read: if signedIn() && (
        isTripMember(resource.data.tripId)
        || isAdmin()
      );

      allow create: if signedIn()
        && request.resource.data.tripId is string
        && tripExists(request.resource.data.tripId)
        && request.resource.data.senderId == uid()
        && request.resource.data.text is string
        && request.resource.data.text.size() > 0
        && (
          isTripMember(request.resource.data.tripId)
          || isAdmin()
        );

      allow update: if false;

      allow delete: if signedIn() && (
        resource.data.senderId == uid()
        || isAdmin()
      );
    }

    match /tripReviews/{reviewId} {
      allow read: if signedIn();

      allow create: if signedIn()
        && request.resource.data.tripId is string
        && tripExists(request.resource.data.tripId)
        && request.resource.data.reviewerId == uid()
        && request.resource.data.revieweeId is string
        && request.resource.data.revieweeId != uid()
        && reviewId == (
          request.resource.data.tripId
          + "_" + uid()
          + "_" + request.resource.data.revieweeId
        )
        && request.resource.data.rating is number
        && request.resource.data.rating >= 1
        && request.resource.data.rating <= 5
        && request.resource.data.comment is string
        && isTripMember(request.resource.data.tripId);

      allow update: if signedIn()
        && resource.data.reviewerId == uid()
        && request.resource.data.reviewerId == uid()
        && request.resource.data.tripId == resource.data.tripId
        && request.resource.data.revieweeId == resource.data.revieweeId
        && reviewId == (
          resource.data.tripId
          + "_" + uid()
          + "_" + resource.data.revieweeId
        )
        && request.resource.data.rating is number
        && request.resource.data.rating >= 1
        && request.resource.data.rating <= 5
        && request.resource.data.comment is string;

      allow delete: if signedIn()
        && (resource.data.reviewerId == uid() || isAdmin());
    }

    match /feedbacks/{feedbackId} {
      allow create: if signedIn()
        && request.resource.data.userId == uid();

      allow read: if isAdmin();

      allow update, delete: if false;
    }

    match /drivers/{driverId} {
      allow read: if signedIn();
      allow create, update, delete: if isAdmin();
    }

    match /tripKickLogs/{logId} {
      allow create: if signedIn()
        && request.resource.data.tripId is string
        && request.resource.data.userId is string
        && request.resource.data.reason is string
        && request.resource.data.reason.size() > 0
        && tripExists(request.resource.data.tripId)
        && uid() == tripOwnerId(request.resource.data.tripId);

      allow read: if signedIn() && (
        isAdmin()
        || uid() == resource.data.userId
        || uid() == tripOwnerId(resource.data.tripId)
      );

      allow update, delete: if false;
    }

    match /tripLeaveLogs/{logId} {
      allow create: if signedIn()
        && request.resource.data.tripId is string
        && request.resource.data.userId == uid()
        && request.resource.data.reason is string
        && request.resource.data.reason.size() > 0
        && tripExists(request.resource.data.tripId)
        && isTripParticipant(request.resource.data.tripId, uid());

      allow read: if signedIn() && (
        isAdmin()
        || uid() == resource.data.userId
        || uid() == tripOwnerId(resource.data.tripId)
      );

      allow update, delete: if false;
    }

    match /driverReviews/{reviewId} {
      allow read: if signedIn();

      allow create: if signedIn()
        && request.resource.data.userId == uid()
        && request.resource.data.driverId is string
        && reviewId == (request.resource.data.driverId + "_" + uid())
        && request.resource.data.rating is number
        && request.resource.data.rating >= 1
        && request.resource.data.rating <= 5
        && request.resource.data.comment is string;

      allow update: if signedIn()
        && resource.data.userId == uid()
        && request.resource.data.userId == uid()
        && request.resource.data.driverId == resource.data.driverId
        && reviewId == (resource.data.driverId + "_" + uid())
        && request.resource.data.rating is number
        && request.resource.data.rating >= 1
        && request.resource.data.rating <= 5
        && request.resource.data.comment is string;

      allow delete: if signedIn()
        && (resource.data.userId == uid() || isAdmin());
    }

    match /notifications/{docId} {
      allow create: if (
        isAdmin()
        && request.resource.data.userId is string
        && request.resource.data.message is string
        && request.resource.data.type is string
      ) || canCreateTripNotification();

      allow read: if signedIn() && (
        resource.data.userId == uid()
        || isAdmin()
      );

      allow update: if isAdmin() || (
        signedIn()
        && resource.data.userId == uid()
        && request.resource.data.diff(resource.data).changedKeys().hasOnly([
          "isRead",
          "readAt"
        ])
        && request.resource.data.isRead == true
        && request.resource.data.readAt is timestamp
      );

      allow delete: if false;
    }
  }
}
